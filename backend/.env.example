# ==========================================================
# CareConnect Backend Environment Configuration (.env.example)
# Duplicate this file as .env in the backend folder:
#   copy .env.example .env
# ==========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
# Local default:
MONGO_URI=mongodb://127.0.0.1:27017/careconnect
# Atlas cloud example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/careconnect?retryWrites=true&w=majority

# Authentication & Security (JWT)
# In production, replace with a 256-bit secure secret key
JWT_SECRET=careconnect-local-dev-signing-key-change-before-production-2026
JWT_EXPIRES_IN=7d

# Quick Start Commands:
# 1. Install dependencies: npm install
# 2. Seed demo data:      npm run seed
# 3. Run development:     npm run dev
# 4. Run tests:           npm test
